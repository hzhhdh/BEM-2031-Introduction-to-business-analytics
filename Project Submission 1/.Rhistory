hr1 <- hr %>%
filter(left == 1) %>%
select(satisfaction_level, last_evaluation)
km1 <- hr1 %>%
kmeans(centers = 3, nstart = 20)
hr1$cluster <- as.character(km1$cluster)
ggplot(hr1, aes(x = satisfaction_level, y = last_evaluation, color = cluster)) +
geom_point(alpha = 0.5)
